PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# MySQL
DB_HOST=your-db.xxxx.af-south-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=CloudSave_db
DB_USERNAME=CloudSave_Admin
DB_PASSWORD=change-me
SKIP_DB_CHECK=change

# Real AWS S3: leave S3_ENDPOINT unset. Leave the keys unset to use the server's IAM role.
AWS_REGION=af-south-1
S3_BUCKET=cloud-save-bucket
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Local S3 (RustFS via docker compose) instead:
# S3_ENDPOINT=http://localhost:9000
# AWS_REGION=us-east-1
# S3_BUCKET=uploads
# S3_ACCESS_KEY=localadmin
# S3_SECRET_KEY=localadmin123
